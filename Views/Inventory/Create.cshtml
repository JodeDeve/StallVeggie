@model StallFruitsManagement.Models.InventoryItem
@{
    ViewData["Title"] = "Create item";
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow">New inventory item</p>
        <h1>Add product</h1>
        <p class="text-muted">Add a fruit or vegetable to your stall inventory.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to inventory</a>
</div>

<div class="card card-panel">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="row gy-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control form-control-lg" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<StallFruitsManagement.Models.CategoryType>()"></select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" type="number" step="0.01" class="form-control form-control-lg" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Unit" class="form-label"></label>
                    <select asp-for="Unit" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<StallFruitsManagement.Models.UnitType>()"></select>
                    <span asp-validation-for="Unit" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control form-control-lg" placeholder="e.g., 85" />
                    <small class="text-muted">Price in Philippine Pesos (PHP)</small>
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label for="imageFile" class="form-label">Product photo</label>
                    <input type="file" id="imageFile" name="imageFile" class="form-control form-control-lg" accept="image/*" />
                    <small class="text-muted">JPG, PNG, GIF or WebP (optional)</small>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg me-2">Save item</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
            </div>
        </form>
    </div>
</div>
