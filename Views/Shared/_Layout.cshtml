<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stall Fruits Management</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StallFruitsManagement.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout d-flex" style="height: 100vh;">
        <!-- Sidebar -->
        <div class="sidebar-nav">
            <div class="sidebar-header">
                <h4 class="mb-0">Inventory</h4>
            </div>
            <nav class="sidebar-nav-menu">
                <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <span class="nav-icon"></span> Dashboard
                </a>
                <a class="nav-link" asp-area="" asp-controller="Inventory" asp-action="Index">
                    <span class="nav-icon"></span> Products
                </a>
                <a class="nav-link" href="#categories">
                    <span class="nav-icon"></span> Categories
                </a>
                <a class="nav-link" href="#stockin">
                    <span class="nav-icon"></span> Stock In
                </a>
                <a class="nav-link" href="#stockout">
                    <span class="nav-icon"></span> Stock Out
                </a>
                <a class="nav-link" href="#suppliers">
                    <span class="nav-icon"></span> Suppliers
                </a>
                <a class="nav-link" href="#reports">
                    <span class="nav-icon"></span> Reports
                </a>
            </nav>
        </div>
        <div id="sidebarOverlay" class="sidebar-overlay d-none"></div>

        <!-- Main Content -->
        <div class="flex-grow-1 d-flex flex-column">
            <header class="navbar navbar-expand-sm navbar-light bg-white border-bottom py-3">
                <div class="container-fluid d-flex align-items-center">
                    <button class="btn sidebar-toggle d-md-none me-3" aria-label="Toggle sidebar" type="button">
                        <span class="hamburger" aria-hidden="true"></span>
                    </button>
                    <a class="navbar-brand fw-bold fs-5" asp-area="" asp-controller="Dashboard" asp-action="Index">
                         Stall Fruits
                    </a>
                </div>
            </header>
            <main role="main" class="flex-grow-1 overflow-auto p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
